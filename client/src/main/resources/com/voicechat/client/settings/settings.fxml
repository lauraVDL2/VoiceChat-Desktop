<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:id="settingsMainPane" xmlns="http://javafx.com/javafx/17.0.12"
          xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.voicechat.client.settings.controller.SettingsController">
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" minWidth="100" prefWidth="100" maxWidth="100" />
        <ColumnConstraints hgrow="ALWAYS" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints maxHeight="50" minHeight="50" prefHeight="50" />
        <RowConstraints vgrow="ALWAYS" />
    </rowConstraints>
    <fx:include source="../mainpage/header.fxml" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"  />
    <fx:include source="../mainpage/left-pane.fxml" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />

    <TabPane prefWidth="600" GridPane.columnIndex="1" GridPane.rowIndex="1" fx:id="settingsPane">
        <Tab closable="false" text="General" styleClass="tabSettingsPane">
            <HBox>
                <Label styleClass="tabSettingsLabel">Theme mode :</Label>
                <Region prefWidth="5" />
                <ChoiceBox fx:id="choiceBoxTheme">
                    <String fx:value="LIGHT" />
                    <String fx:value="DARK" />
                </ChoiceBox>
            </HBox>
        </Tab>
        <Tab closable="false" text="Devices" styleClass="tabSettingsPane">

        </Tab>
    </TabPane>
</GridPane>
